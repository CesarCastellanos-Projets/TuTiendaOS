rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS & RBAC DE SEGURIDAD ──────────────────
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function userRole() {
      return userDoc().get('role', '');
    }

    function isAdmin() {
      return signedIn() && (
        userRole() == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email', '') == 'admin@denzoz.pe' && request.auth.token.get('email_verified', false) == true)
      );
    }

    function isPos() {
      return signedIn() && (userRole() == 'pos' || isAdmin());
    }

    function isWorker() {
      return signedIn() && (userRole() == 'trabajador' || isPos());
    }

    function str(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function nonNegNum(v) {
      return (v is number || v is int) && v >= 0 && v <= 9999999;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── 1. CONFIGURACIÓN DE LA EMPRESA (SINGLETON) ────────────
    match /company/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && str(request.resource.data.razonSocial, 1, 120);
      allow delete: if false;
    }

    // ─── 2. USUARIOS Y ROLES DE ACCESO ─────────────────────────
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Solo administradores pueden crear nuevos usuarios y asignar roles
      allow create: if isAdmin()
        && str(request.resource.data.displayName, 2, 80)
        && str(request.resource.data.email, 5, 120)
        && request.resource.data.role in ['admin', 'pos', 'trabajador']
        && request.resource.data.active is bool;

      // Actualizaciones: Admin gestiona roles/estados; el usuario solo su propio nombre
      allow update: if (
          isAdmin()
          && request.resource.data.role in ['admin', 'pos', 'trabajador']
          && request.resource.data.active is bool
          && str(request.resource.data.displayName, 2, 80)
        ) || (
          signedIn()
          && request.auth.uid == uid
          && changedKeys().hasOnly(['displayName'])
          && str(request.resource.data.displayName, 2, 80)
        );

      allow delete: if isAdmin();
    }

    // ─── 3. TIENDAS Y ALMACENES ────────────────────────────────
    match /stores/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && str(request.resource.data.name, 1, 80)
        && str(request.resource.data.code, 1, 20);
      allow delete: if isAdmin();
    }

    match /warehouses/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && str(request.resource.data.name, 1, 80)
        && str(request.resource.data.code, 1, 20);
      allow delete: if isAdmin();
    }

    // ─── 4. CATÁLOGO DE PRODUCTOS Y PRESENTACIONES ─────────────
    match /products/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && str(request.resource.data.name, 1, 150)
        && nonNegNum(request.resource.data.salePrice)
        && str(request.resource.data.unit, 1, 30);
      allow delete: if isAdmin();
    }

    // ─── 5. EXISTENCIAS POR UBICACIÓN (PRODUCT_STOCKS) ─────────
    match /product_stocks/{stockId} {
      allow read: if signedIn();

      // Creación al recibir o inicializar producto en tienda o almacén
      allow create: if (isAdmin() || isPos())
        && str(request.resource.data.productId, 1, 64)
        && str(request.resource.data.locationId, 1, 64)
        && (request.resource.data.quantity is number || request.resource.data.quantity is int)
        && request.resource.data.quantity >= 0;

      // Actualizaciones controladas de existencias
      allow update: if (isAdmin() || isPos())
        && (request.resource.data.quantity is number || request.resource.data.quantity is int)
        && request.resource.data.quantity >= 0;

      allow delete: if isAdmin();
    }

    // ─── 6. KÁRDEX Y MOVIMIENTOS (INMUTABLE / APPEND-ONLY) ─────
    match /stock_movements/{id} {
      allow read: if signedIn();
      allow create: if (isAdmin() || isPos() || isWorker())
        && str(request.resource.data.productId, 1, 64)
        && request.resource.data.type in ['venta', 'ingreso', 'transferencia', 'ajuste', 'merma', 'recepcion']
        && (request.resource.data.qty is number || request.resource.data.qty is int)
        && request.resource.data.qty != 0
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Auditoría inmutable de inventario
    }

    // ─── 7. TRANSFERENCIAS DE MERCADERÍA ───────────────────────
    match /transfers/{id} {
      function validTransferItems(items) {
        return items is list && items.size() >= 1 && items.size() <= 300
          && items.all(item,
            item.productId is string
            && str(item.name, 1, 150)
            && (item.qtySent is number || item.qtySent is int) && item.qtySent > 0
            && (item.qtyReceived is number || item.qtyReceived is int) && item.qtyReceived >= 0);
      }

      allow read: if signedIn();

      allow create: if (isAdmin() || isPos())
        && str(request.resource.data.code, 3, 30)
        && str(request.resource.data.fromLocationId, 1, 64)
        && str(request.resource.data.toLocationId, 1, 64)
        && request.resource.data.fromLocationId != request.resource.data.toLocationId
        && request.resource.data.status == 'pendiente'
        && validTransferItems(request.resource.data.items);

      allow update: if (isAdmin() || isPos())
        && request.resource.data.status in ['pendiente', 'en_transito', 'recibido', 'cancelado'];

      allow delete: if isAdmin();
    }

    // ─── 8. SOLICITUDES DE REPOSICIÓN ──────────────────────────
    match /replenishment_requests/{id} {
      allow read: if signedIn();

      allow create: if (isPos() || isAdmin())
        && str(request.resource.data.storeId, 1, 64)
        && request.resource.data.status == 'pendiente'
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 200
        && request.resource.data.items.all(item,
          item.productId is string
          && str(item.name, 1, 150)
          && (item.requestedQty is number || item.requestedQty is int) && item.requestedQty > 0);

      allow update: if (isAdmin() || isPos())
        && request.resource.data.status in ['pendiente', 'atendida', 'rechazada'];

      allow delete: if isAdmin();
    }

    // ─── 9. INCIDENCIAS DE PISO Y MERMAS ───────────────────────
    match /incidents/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && str(request.resource.data.productId, 1, 64)
        && request.resource.data.type in ['danado', 'vencido', 'sin_etiqueta', 'sin_codigo', 'otro']
        && str(request.resource.data.description, 3, 500)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.status in ['abierta', 'resuelta', 'descartada'];

      allow delete: if isAdmin();
    }

    // ─── 10. VENTAS, BOLETAS Y FACTURAS ────────────────────────
    match /sales/{id} {
      function validSaleItems(items) {
        return items is list && items.size() >= 1 && items.size() <= 300
          && items.all(item,
            item.productId is string
            && str(item.name, 1, 150)
            && (item.qty is number || item.qty is int) && item.qty > 0
            && nonNegNum(item.unitPrice)
            && nonNegNum(item.total));
      }

      allow read: if signedIn();

      allow create: if (isPos() || isAdmin())
        && str(request.resource.data.code, 5, 30)
        && request.resource.data.type in ['boleta', 'factura']
        && request.resource.data.paymentMethod in ['efectivo', 'tarjeta', 'yape', 'plin', 'otro']
        && request.resource.data.status == 'activa'
        && nonNegNum(request.resource.data.total)
        && nonNegNum(request.resource.data.subtotal)
        && nonNegNum(request.resource.data.igv)
        && request.resource.data.userId == request.auth.uid
        && validSaleItems(request.resource.data.items);

      allow update: if (isAdmin() || isPos())
        && request.resource.data.status in ['activa', 'anulada'];

      allow delete: if false; // Comprobantes fiscales nunca se eliminan
    }

    // ─── 11. TURNOS Y CONTROL DE CAJA (CORTE Z) ────────────────
    match /cash_sessions/{id} {
      allow read: if signedIn();

      allow create: if (isPos() || isAdmin())
        && nonNegNum(request.resource.data.openingAmount)
        && request.resource.data.status == 'abierta'
        && request.resource.data.userId == request.auth.uid;

      allow update: if (isPos() || isAdmin())
        && request.resource.data.status in ['abierta', 'cerrada'];

      allow delete: if isAdmin();
    }

    // ─── 12. CLIENTES (CACHÉ DNI / RUC) ────────────────────────
    match /clients/{docId} {
      allow read: if signedIn();
      allow create, update: if (isPos() || isAdmin())
        && request.resource.data.tipo in ['DNI', 'RUC']
        && str(request.resource.data.nombre, 1, 150);
      allow delete: if isAdmin();
    }

    // ─── 13. CORRELATIVOS FISCALES (COUNTERS) ──────────────────
    match /counters/{serie} {
      allow read: if signedIn();
      allow create: if (isPos() || isAdmin())
        && (request.resource.data.current is number || request.resource.data.current is int)
        && request.resource.data.current >= 0;
      allow update: if (isPos() || isAdmin())
        && (request.resource.data.current is number || request.resource.data.current is int)
        && request.resource.data.current >= resource.data.current;
      allow delete: if false;
    }

    // ─── 14. COTIZACIONES (LISTAS ESCOLARES Y PEDIDOS) ─────────
    match /quotations/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && str(request.resource.data.code, 5, 30)
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 300
        && nonNegNum(request.resource.data.totalAll)
        && nonNegNum(request.resource.data.totalAvailable)
        && request.resource.data.status in ['pendiente', 'facturada', 'descartada']
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.status in ['pendiente', 'facturada', 'descartada'];

      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }
  }
}