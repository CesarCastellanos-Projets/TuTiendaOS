rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Modelo asumido
    // ===============================================================
    // users/{uid}: perfil privado, rol y tenant (roles inmutables para el usuario).
    // tenants/{tenantId}/products/{id}: catálogo; lectura de la empresa, escritura solo Admin SDK.
    // barcode_registry/{id}: reserva única de código; solo Admin SDK.
    // product_stocks/{id}, stock_movements/{id}: inventario y kardex; escritura solo Admin SDK.
    // sales/{id}, transfers/{id}, counters/{id}, clients/{id}: flujos críticos; creación/mutación por Functions.
    // config, stores, warehouses: administración validada por esquema y rol admin.
    // replenishment_requests, incidents, quotations, cash_sessions: escrituras cliente validadas y acotadas.
    // Todas las rutas de tenant exigen que users/{uid}.tenantId coincida con la ruta.
    // ===============================================================
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() {
      return signedIn() && profile().data.active == true
        && profile().data.role in ['admin', 'pos', 'trabajador']
        && profile().data.tenantId is string;
    }
    function isAdmin() { return activeUser() && profile().data.role == 'admin'; }
    function isPos() { return activeUser() && profile().data.role == 'pos'; }
    function isWorker() { return activeUser() && profile().data.role == 'trabajador'; }
    function userTenantId() { return profile().data.tenantId; }
    function userStoreId() { return profile().data.storeId; }
    function belongsToTenant(tenantId) { return activeUser() && userTenantId() == tenantId; }
    function validTenantData(data, tenantId) { return data.tenantId is string && data.tenantId == tenantId; }
    function shortString(value, maxLength) { return value is string && value.size() <= maxLength; }

    function validCompany(data) {
      return data.keys().hasAll([
          'ruc', 'razonSocial', 'serieFactura', 'serieBoleta', 'entornoSunat',
          'igvRate', 'minBoletaSinDni', 'umbralConsolidacion', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ruc', 'razonSocial', 'direccion', 'regimen', 'serieFactura', 'serieBoleta',
          'serieNota', 'entornoSunat', 'igvRate', 'minBoletaSinDni', 'umbralConsolidacion',
          'certFileName', 'certExpiresAt', 'certIssuer', 'isDemoMode', 'logoUrl', 'slogan',
          'phone', 'footerText', 'ticketWidth', 'customUnits', 'updatedAt'
        ])
        && shortString(data.ruc, 11) && shortString(data.razonSocial, 160)
        && shortString(data.serieFactura, 8) && shortString(data.serieBoleta, 8)
        && data.igvRate is number && data.igvRate >= 0 && data.igvRate <= 1
        && data.minBoletaSinDni is number && data.minBoletaSinDni >= 0
        && data.umbralConsolidacion is number && data.umbralConsolidacion >= 0
        && data.entornoSunat in ['beta', 'produccion']
        && (!('customUnits' in data) || (data.customUnits is list && data.customUnits.size() <= 50));
    }

    function validUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'active', 'tenantId'])
        && data.keys().hasOnly(['displayName', 'email', 'role', 'active', 'tenantId', 'storeId', 'storeAccess', 'warehouseId', 'createdAt'])
        && shortString(data.displayName, 120) && shortString(data.email, 160)
        && shortString(data.tenantId, 63) && data.role in ['admin', 'pos', 'trabajador']
        && data.active is bool
        && (!('storeId' in data) || data.storeId == null || shortString(data.storeId, 128))
        && (!('storeAccess' in data)
          || (data.role == 'pos' && data.storeAccess in ['assigned', 'all'])
          || (data.role != 'pos' && data.storeAccess == 'assigned'))
        && (!('warehouseId' in data) || data.warehouseId == null || shortString(data.warehouseId, 128));
    }

    function validReplenishment(data, tenantId) {
      return validTenantData(data, tenantId)
        && data.keys().hasAll(['tenantId', 'storeId', 'storeName', 'items', 'status', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'storeId', 'storeName', 'items', 'status', 'createdBy', 'createdByName', 'createdAt', 'note'])
        && shortString(data.storeId, 128) && shortString(data.storeName, 120)
        && shortString(data.createdBy, 128) && shortString(data.createdByName, 120)
        && data.createdAt is number && data.createdAt > 0
        && data.status == 'pendiente'
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && (!('note' in data) || data.note == null || shortString(data.note, 250));
    }

    function validIncident(data, tenantId) {
      return validTenantData(data, tenantId)
        && data.keys().hasAll(['tenantId', 'storeId', 'storeName', 'type', 'description', 'status', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'storeId', 'storeName', 'productId', 'productName', 'type', 'description', 'photoUrl', 'status', 'createdBy', 'createdByName', 'createdAt', 'resolutionNote', 'resolvedBy', 'resolvedByName', 'resolvedAt'])
        && shortString(data.storeId, 128) && shortString(data.storeName, 120)
        && data.type in ['danado', 'vencido', 'sin_etiqueta', 'sin_codigo', 'otro']
        && shortString(data.description, 1000)
        && shortString(data.createdBy, 128) && shortString(data.createdByName, 120)
        && data.status in ['abierta', 'resuelta'] && data.createdAt is number
        && (!('productId' in data) || data.productId == null || shortString(data.productId, 128))
        && (!('productName' in data) || data.productName == null || shortString(data.productName, 180))
        && (!('photoUrl' in data) || data.photoUrl == null || shortString(data.photoUrl, 1000))
        && (!('resolutionNote' in data) || data.resolutionNote == null || shortString(data.resolutionNote, 1000));
    }

    function validCashSession(data, tenantId) {
      return validTenantData(data, tenantId)
        && data.keys().hasAll(['tenantId', 'storeId', 'userId', 'userName', 'openingAmount', 'status', 'openedAt'])
        && data.keys().hasOnly(['tenantId', 'storeId', 'userId', 'userName', 'openingAmount', 'closingAmount', 'expectedAmount', 'difference', 'status', 'openedAt', 'closedAt'])
        && shortString(data.storeId, 128) && shortString(data.userId, 128) && shortString(data.userName, 120)
        && data.openingAmount is number && data.openingAmount >= 0 && data.openingAmount <= 100000000
        && data.status in ['abierta', 'cerrada'] && data.openedAt is number
        && (!('closingAmount' in data) || data.closingAmount == null || (data.closingAmount is number && data.closingAmount >= 0 && data.closingAmount <= 100000000))
        && (!('expectedAmount' in data) || data.expectedAmount == null || (data.expectedAmount is number && data.expectedAmount >= 0 && data.expectedAmount <= 100000000))
        && (!('difference' in data) || data.difference == null || (data.difference is number && data.difference >= -100000000 && data.difference <= 100000000))
        && (!('closedAt' in data) || data.closedAt == null || data.closedAt is number);
    }

    function validQuotation(data, tenantId) {
      return validTenantData(data, tenantId)
        && data.keys().hasAll(['tenantId', 'id', 'code', 'storeId', 'storeName', 'items', 'totalAll', 'totalAvailable', 'createdBy', 'createdByName', 'status', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'id', 'code', 'clientName', 'clientPhone', 'storeId', 'storeName', 'items', 'totalAll', 'totalAvailable', 'note', 'createdBy', 'createdByName', 'status', 'createdAt'])
        && shortString(data.id, 128) && shortString(data.code, 40)
        && shortString(data.storeId, 128) && shortString(data.storeName, 120)
        && shortString(data.createdBy, 128) && shortString(data.createdByName, 120)
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.totalAll is number && data.totalAll >= 0 && data.totalAll <= 100000000
        && data.totalAvailable is number && data.totalAvailable >= 0 && data.totalAvailable <= 100000000
        && data.status in ['pendiente', 'facturada', 'descartada'] && data.createdAt is number
        && (!('clientName' in data) || data.clientName == null || shortString(data.clientName, 180))
        && (!('clientPhone' in data) || data.clientPhone == null || shortString(data.clientPhone, 30))
        && (!('note' in data) || data.note == null || shortString(data.note, 500));
    }

    match /users/{uid} {
      allow get: if activeUser() && (request.auth.uid == uid || (isAdmin() && resource.data.tenantId == userTenantId()));
      allow list: if isAdmin() && resource.data.tenantId == userTenantId();
      allow create: if isAdmin() && validUser(request.resource.data) && request.resource.data.tenantId == userTenantId();
      allow update: if (isAdmin() && resource.data.tenantId == userTenantId()
          && validUser(request.resource.data) && request.resource.data.tenantId == userTenantId())
        || (activeUser() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && validUser(request.resource.data)
          && shortString(request.resource.data.displayName, 120));
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read, write: if false;

      match /config/{configId} {
        allow read: if belongsToTenant(tenantId)
          && !resource.data.keys().hasAny(['solUser', 'solPassword', 'apiFactUrl', 'apiFactToken']);
        allow create, update: if belongsToTenant(tenantId) && isAdmin() && validCompany(request.resource.data);
        allow delete: if false;
      }
      match /stores/{storeId} {
        allow read: if belongsToTenant(tenantId);
        allow create, update: if belongsToTenant(tenantId) && isAdmin()
          && validTenantData(request.resource.data, tenantId)
          && request.resource.data.keys().hasAll(['tenantId', 'name', 'code', 'address'])
          && request.resource.data.keys().hasOnly(['tenantId', 'name', 'code', 'address'])
          && shortString(request.resource.data.name, 120)
          && shortString(request.resource.data.code, 30)
          && shortString(request.resource.data.address, 240);
        allow delete: if belongsToTenant(tenantId) && isAdmin();
      }
      match /warehouses/{warehouseId} {
        allow read: if belongsToTenant(tenantId);
        allow create, update: if belongsToTenant(tenantId) && isAdmin()
          && validTenantData(request.resource.data, tenantId)
          && request.resource.data.keys().hasAll(['tenantId', 'name', 'code', 'isCentral'])
          && request.resource.data.keys().hasOnly(['tenantId', 'name', 'code', 'isCentral'])
          && shortString(request.resource.data.name, 120)
          && shortString(request.resource.data.code, 30)
          && request.resource.data.isCentral is bool;
        allow delete: if belongsToTenant(tenantId) && isAdmin();
      }
      match /products/{productId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && isAdmin();
      }
      match /barcode_registry/{barcodeId} {
        allow read, write: if belongsToTenant(tenantId) && isAdmin();
      }
      match /meta/{metaId} {
        allow read: if belongsToTenant(tenantId);
        allow create, update: if belongsToTenant(tenantId) && isAdmin()
          && metaId == 'catalog'
          && validTenantData(request.resource.data, tenantId)
          && request.resource.data.keys().hasAll(['tenantId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['tenantId', 'updatedAt'])
          && request.resource.data.updatedAt is number;
        allow delete: if false;
      }
      match /product_stocks/{stockId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && isAdmin();
      }
      match /stock_movements/{movementId} {
        allow read: if belongsToTenant(tenantId) && isAdmin();
        allow write: if belongsToTenant(tenantId) && isAdmin();
      }
      match /transfers/{transferId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || (isPos() && resource.data.toLocationId == userStoreId()));
        allow write: if false;
      }
      match /replenishment_requests/{requestId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || (isPos() && resource.data.storeId == userStoreId()
            && resource.data.createdBy == request.auth.uid));
        allow create: if belongsToTenant(tenantId) && isPos()
          && validReplenishment(request.resource.data, tenantId)
          && request.resource.data.storeId == userStoreId()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pendiente'
          && request.resource.data.items is list && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 100;
        allow update, delete: if false;
      }
      match /incidents/{incidentId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || ((isPos() || isWorker()) && resource.data.storeId == userStoreId()));
        allow create: if belongsToTenant(tenantId) && (isPos() || isWorker())
          && validIncident(request.resource.data, tenantId)
          && request.resource.data.storeId == userStoreId()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'abierta';
        allow update: if belongsToTenant(tenantId) && isAdmin()
          && validIncident(request.resource.data, tenantId);
        allow delete: if false;
      }
      match /sales/{saleId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || (isPos() && resource.data.userId == request.auth.uid
            && resource.data.storeId == userStoreId()));
        allow create: if false;
        allow update: if belongsToTenant(tenantId) && isPos()
          && resource.data.tenantId == tenantId
          && resource.data.userId == request.auth.uid && resource.data.storeId == userStoreId()
          && (!('anulationRequest' in resource.data) || resource.data.anulationRequest == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulationRequest', 'anulationStatus'])
          && request.resource.data.anulationRequest is map
          && request.resource.data.anulationRequest.keys().hasOnly(['reason', 'byUserId', 'byUserName', 'requestedAt'])
          && request.resource.data.anulationRequest.reason is string
          && request.resource.data.anulationRequest.reason.size() > 0
          && request.resource.data.anulationRequest.reason.size() <= 250
          && request.resource.data.anulationRequest.byUserId == request.auth.uid
          && request.resource.data.anulationStatus == 'solicitada';
        allow delete: if false;
      }
      match /cash_sessions/{sessionId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || (isPos() && resource.data.userId == request.auth.uid
            && resource.data.storeId == userStoreId()));
        allow create: if belongsToTenant(tenantId) && isPos()
          && validCashSession(request.resource.data, tenantId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.storeId == userStoreId()
          && request.resource.data.status == 'abierta';
        allow update: if belongsToTenant(tenantId) && isPos()
          && resource.data.tenantId == tenantId
          && validCashSession(request.resource.data, tenantId)
          && resource.data.userId == request.auth.uid && resource.data.storeId == userStoreId()
          && resource.data.status == 'abierta' && request.resource.data.status == 'cerrada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'closingAmount', 'expectedAmount', 'difference']);
        allow delete: if false;
      }
      match /clients/{clientId} { allow read, write: if false; }
      match /quotations/{quotationId} {
        allow get, list: if belongsToTenant(tenantId)
          && (isAdmin() || ((isPos() || isWorker()) && resource.data.storeId == userStoreId()));
        allow create: if belongsToTenant(tenantId) && (isPos() || isWorker())
          && validQuotation(request.resource.data, tenantId)
          && request.resource.data.storeId == userStoreId()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pendiente'
          && request.resource.data.items is list && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 100;
        allow update: if belongsToTenant(tenantId)
          && validQuotation(request.resource.data, tenantId)
          && (isAdmin() || ((isPos() || isWorker())
            && resource.data.storeId == userStoreId()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pendiente', 'facturada', 'descartada']));
        allow delete: if false;
      }
      match /counters/{counterId} { allow read, write: if false; }
      match /{document=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
