rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function scheduleWindow(s) {
      let local = request.time.toMillis() - 18000000;
      let day = (int(local / 86400000) + 4) % 7;
      let minute = int(local / 60000) % 1440;
      return s is map && s.days is list && s.days.size() > 0 && s.days.size() <= 7
        && s.days.hasOnly([0,1,2,3,4,5,6]) && s.start is int && s.end is int
        && s.start >= 0 && s.start <= 1439 && s.end >= 0 && s.end <= 1439
        && (s.start <= s.end ? (day in s.days && minute >= s.start && minute <= s.end)
          : ((day in s.days && minute >= s.start) || ((day + 6) % 7 in s.days && minute <= s.end)));
    }
    function authorizedTime() {
      return request.auth.token.get('auth_time', 0) >= profile().data.get('authValidAfter', 0)
        && (profile().data.role == 'admin' || profile().data.get('accessSchedule', null) == null
          || scheduleWindow(profile().data.accessSchedule));
    }
    function activeUser() {
      return signedIn() && profile().data.active == true && profile().data.tenantId is string && authorizedTime();
    }
    function belongsToTenant(tenantId) {
      return activeUser() && profile().data.tenantId == tenantId;
    }
    function isAdmin(tenantId) {
      return belongsToTenant(tenantId) && profile().data.role == 'admin';
    }

    match /tenants/{tenantId}/incidents/{userId}/{fileName} {
      allow read: if isAdmin(tenantId) || (belongsToTenant(tenantId) && request.auth.uid == userId);
      allow write: if false;
    }
    match /tenants/{tenantId}/incidents/{storeId}/{userId}/{fileName} {
      allow read: if isAdmin(tenantId) || (belongsToTenant(tenantId)
        && profile().data.role in ['pos', 'trabajador'] && profile().data.storeId == storeId);
      allow create: if belongsToTenant(tenantId) && request.auth.uid == userId
        && profile().data.role in ['pos', 'trabajador'] && profile().data.storeId == storeId
        && fileName.matches('[a-zA-Z0-9_.-]+')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update: if false;
      allow delete: if isAdmin(tenantId) || (belongsToTenant(tenantId) && request.auth.uid == userId && profile().data.storeId == storeId);
    }

    match /tenants/{tenantId}/certificates/{fileName} {
      allow read: if isAdmin(tenantId);
      allow create: if isAdmin(tenantId)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('application/(x-pkcs12|octet-stream|pkix-cert).*');
      allow update: if false;
      allow delete: if isAdmin(tenantId);
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
