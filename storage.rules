rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fotos de incidencias reportadas desde el piso
    match /incidents/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    // Certificado digital SUNAT: solo Admin sube; el microservicio lee vía Admin SDK
    match /certificates/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('application/(x-pkcs12|octet-stream|pkix-cert).*');
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
