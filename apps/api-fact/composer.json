{
    "name": "denzoz/api-fact",
    "description": "Motor tributario D'ENZOZ: boletas/facturas electr\u00c3\u00b3nicas SUNAT con Greenter",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.69.0",
        "greenter/greenter": "^5.1",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
