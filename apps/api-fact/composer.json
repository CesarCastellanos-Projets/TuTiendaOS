{
    "name": "denzoz/api-fact",
    "description": "Motor tributario D'ENZOZ: boletas/facturas electrónicas SUNAT con Greenter",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "greenter/greenter": "^5.1",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
