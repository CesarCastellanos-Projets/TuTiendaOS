APP_NAME="D'ENZOZ API FACT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Token que la PWA envía en el header X-API-TOKEN
API_FACT_TOKEN=cambia-este-token-largo-y-seguro

# Datos del emisor
SUNAT_RUC=20123456789
SUNAT_RAZON_SOCIAL=D'ENZOZ SAC
SUNAT_DIRECCION=Av. Real 123, Huancayo
SUNAT_UBIGEO=120101

# beta | produccion
SUNAT_ENV=beta

# Credenciales SOL (usuario secundario con permisos FE)
SUNAT_SOL_USER=MODDATOS
SUNAT_SOL_PASSWORD=

# Certificado digital
SUNAT_CERT_PATH=storage/app/sunat/certificate.pfx
SUNAT_CERT_PASSWORD=
